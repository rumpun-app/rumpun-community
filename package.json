{
  "name": "rumpun-community",
  "private": true,
  "scripts": {
    "web:dev": "pnpm --filter @rumpun/web dev",
    "web:build": "pnpm --filter @rumpun/web build",
    "web:lint": "pnpm --filter @rumpun/web lint",
    "web:typecheck": "pnpm --filter @rumpun/web typecheck",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.27.0"
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @rumpun/api build",
    "dev": "pnpm --filter @rumpun/api dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @rumpun/api test",
    "format": "prettier --check \"**/*.{ts,tsx,json,yaml,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "check": "pnpm format && pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "better-sqlite3", "esbuild"]
  }
}
